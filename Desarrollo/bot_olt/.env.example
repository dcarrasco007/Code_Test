# Plantilla de variables de entorno del bot OLT.
# Copiar como .env y completar con los valores reales.
# El .env NO se versiona: las credenciales nunca van dentro del codigo ni en git.

# --- Telegram ---
BOT_TOKEN=8349653665:AAE0_hcTJxIn1bPS0IBizR_guocbaEKz4s4
BOT_TOKEN_TEST=8446216892:AAF3pBiocqhUDD1Etg3TpYC9KScnqXsBGRc

# --- Base de datos (esquema Aden) ---
# Formato: mysql+pymysql://usuario:password@host:puerto/base?charset=utf8mb4
CONECTION_ADEN=mysql+pymysql://adminAden:adenl2.,123@172.29.159.57:3306/Aden?charset=utf8mb4

# --- Perfiles con acceso a opciones privilegiadas ---
# Valores de OLT_BOT_USUARIOS.perfil habilitados para resetear contrasenas,
# separados por coma (ej. PERFILES_ADMIN=1,2).
# Si queda vacio NADIE ve la opcion: el default es el mas restrictivo.
PERFILES_ADMIN=

# --- Control de abuso (opcional: si se omite, aplican estos defaults) ---
# Segundos que se recuerda si un chat_id esta autorizado. Evita una consulta
# a la base por cada mensaje recibido. Subirlo alivia la base; bajarlo hace
# que un alta o una revocacion tomen efecto antes.
AUTH_CACHE_TTL=60

# Peticiones permitidas por chat_id dentro de la ventana (en segundos).
RATE_LIMIT_PETICIONES=20
RATE_LIMIT_VENTANA=60

# Cuantas veces se le responde a un no autorizado antes de dejar de hacerlo,
# y por cuantos segundos se le ignora despues.
MAX_INTENTOS_NO_AUTORIZADO=3
SILENCIO_NO_AUTORIZADO=300

# --- Salida a internet (solo si el servidor usa proxy) ---
PROXY=
