# Plantilla de variables de entorno del bot OLT.
# Copiar como .env y completar con los valores reales.
# El .env NO se versiona: las credenciales nunca van dentro del codigo ni en git.

# --- Telegram ---
BOT_TOKEN=
BOT_TOKEN_TEST=

# --- Base de datos (esquema Aden) ---
# Formato: mysql+pymysql://usuario:password@host:puerto/base?charset=utf8mb4
CONECTION_ADEN=mysql+pymysql://USUARIO:PASSWORD@172.29.159.57:3306/Aden?charset=utf8mb4

# --- Salida a internet (solo si el servidor usa proxy) ---
PROXY=
