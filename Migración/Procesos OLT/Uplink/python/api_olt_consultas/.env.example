# ============================================================================
# .env.example — Plantilla de variables de entorno de api_olt_consultas
# Copiar como .env y completar. El .env NUNCA se versiona (va en .gitignore).
# En el servidor: chmod 600 .env
# ============================================================================

# ---- Base de datos (esquema Aden) ----
# Formato: mysql+pymysql://usuario:password@host:puerto/base?charset=utf8mb4
CONECTION_ADEN=

# ---- Servidor HTTP ----
# IMPORTANTE: la API se expone SIN nginx/TLS (decision del proyecto), solo red
# interna. No usar 0.0.0.0 si el servidor tiene interfaz publica.
API_HOST=127.0.0.1
API_PORT=5001

# Origenes CORS permitidos, separados por coma. NUNCA usar "*" en produccion.
CORS_ORIGINS=

# Exponer /docs y /redoc (dejar en false en produccion)
API_DOCS_HABILITADO=true

# ---- Credenciales telnet de las OLT ----
# Usuario DEDICADO de la API (cupo propio de 3 sesiones por OLT).
# Mientras no exista en los equipos, dejar OLT_TELNET_API_DEDICADO=false:
# la API compartira los usuarios de los crons y bajara su cupo a 1.
OLT_TELNET_API_DEDICADO=false
OLT_TELNET_API_USER=geretapi
OLT_TELNET_API_PASS=

# Usuarios heredados de los procesos PHP (fallback si no hay usuario dedicado).
OLT_TELNET_DEFAULT_USER=
OLT_TELNET_DEFAULT_PASS=
OLT_TELNET_ALARMAS_USER=
OLT_TELNET_ALARMAS_PASS=
OLT_TELNET_ONT_USER=
OLT_TELNET_ONT_PASS=

# ---- Control de sesiones telnet ----
# Limite duro del equipo: 3 sesiones simultaneas por (OLT, usuario).
# Con usuario dedicado el cupo efectivo es 3; sin el, la API lo baja a 1.
# Este valor solo puede BAJAR el cupo, nunca subirlo por encima de 3.
CUPO_API_POR_OLT_USUARIO=3
# Segundos que una peticion espera en cola por un cupo libre antes de 503.
ESPERA_MAX_SESION_SEG=60
# Segundos sin reintentar una OLT tras detectar rechazo por limite de sesiones.
BLOQUEO_OLT_SEG=120
# Sesiones telnet simultaneas en total (todas las OLT).
TELNET_MAX_CONCURRENTES=20
# Timeout por defecto de una sesion telnet (segundos); cada consulta puede tener el suyo.
TELNET_TIMEOUT_SEG=30

# ---- Seguridad de la API ----
# Intentos de autenticacion fallidos por IP antes de bloquear, y minutos de bloqueo.
MAX_INTENTOS_AUTH=5
BLOQUEO_AUTH_MINUTOS=15
# Rate limit por defecto de cada cliente (se puede sobrescribir por cliente en BD).
RATE_LIMIT_PETICIONES=60
RATE_LIMIT_VENTANA=60

# ---- Ejecucion sincrona vs asincrona ----
# Sobre estos limites la peticion devuelve job_id en vez de esperar.
MAX_OLTS_SYNC=1
MAX_COMANDOS_REQUEST=30
MAX_OLTS_REQUEST=5
# Margen (segundos) que se suma al timeout propio de la consulta antes de 504.
EJECUCION_SYNC_MARGEN_SEG=15
# Timeout total de un job asincrono (lote / ejecucion larga) antes de TIMEOUT.
JOB_TIMEOUT_SEG=900

# ---- Lectura desde BD (F5) ----
# Tope de filas que devuelve un endpoint de lectura con ?desde&hasta.
LIMITE_FILAS_RANGO=5000

# ---- Hardening HTTP (F8) ----
# Tamano maximo del body de una peticion (bytes). Solo /ejecutar/* lleva body.
MAX_BODY_BYTES=65536
# Tope del texto crudo de telnet que se PERSISTE en OLT_API_LOG_TELNET (bytes).
MAX_LOG_CRUDO_BYTES=1000000

# ---- Retencion de logs ----
LOG_RETENCION_DIAS=30
