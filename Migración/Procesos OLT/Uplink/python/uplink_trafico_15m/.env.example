# ── Base de datos Aden ──────────────────────────────────────────────────────
# Copiar este archivo como .env y completar con los valores reales.
# NUNCA versionar el .env real.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=Aden
DB_CHARSET=utf8

# ── Credenciales telnet de las OLT Huawei ───────────────────────────────────
# Usuario/clave con que el proceso hace telnet a cada equipo OLT.
# En el PHP estaban hardcodeadas (geret2016 / Geret#2016*2021).
OLT_TELNET_USER=
OLT_TELNET_PASS=

# ── Rutas (opcional) ────────────────────────────────────────────────────────
# Dejar vacío para usar la ruta por defecto (<raíz_proyecto>/logs).
# LOGS_DIR=

# ── Parámetros (opcional) ───────────────────────────────────────────────────
# Timeout de expect por comando telnet (segundos). Por defecto 2 (igual que el PHP).
# TELNET_TIMEOUT=2
